#!/usr/bin/env python3
"""nonslop CLI. On the Bash tool's PATH while the plugin is enabled.

  nonslop init     wire the current project (config, settings template, .gitignore)
  nonslop doctor   show what is wired and which tools are present
"""

import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
TEMPLATES = PLUGIN_ROOT / "templates"
OPTIONAL_TOOLS = ["git", "gh", "ast-grep", "jscpd", "gitleaks", "shellcheck", "sccache"]


def project_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        sys.exit("nonslop: not inside a git repository")
    return Path(result.stdout.strip())


def copy_if_absent(source: Path, target: Path) -> None:
    if target.exists():
        print(f"  keep    {target} (already exists)")
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    print(f"  create  {target}")


def ensure_ignored(root: Path, entry: str) -> None:
    gitignore = root / ".gitignore"
    lines = gitignore.read_text(encoding="utf-8").splitlines() if gitignore.exists() else []
    if entry in lines:
        return
    with gitignore.open("a", encoding="utf-8") as handle:
        handle.write(f"{entry}\n")
    print(f"  ignore  {entry}")


def init() -> int:
    root = project_root()
    copy_if_absent(TEMPLATES / "nonslop.toml", root / ".nonslop.toml")
    copy_if_absent(TEMPLATES / "settings.json", root / ".claude" / "settings.json")
    ensure_ignored(root, ".claude/tmp/")
    print("\nNext: fill in [commands] in .nonslop.toml, review .claude/settings.json, commit both.")
    return 0


def doctor() -> int:
    root = project_root()
    config_path = root / ".nonslop.toml"
    if not config_path.exists():
        print(f"not wired: {config_path} missing (run `nonslop init`)")
        return 1
    with config_path.open("rb") as handle:
        config = tomllib.load(handle)
    print(f"project   {root}")
    for name, command in config.get("commands", {}).items():
        print(f"command   {name}: {command or '(empty)'}")
    state = config.get("state", {}).get("file")
    if state:
        print(f"state     {state} ({'present' if (root / state).exists() else 'missing'})")
    print(f"done      {config.get('done', {}).get('require', [])}")
    slopstop = PLUGIN_ROOT / "tools" / "slopstop" / "slop.py"
    print(f"slopstop  {'present' if slopstop.exists() else 'not vendored yet'}")
    for tool in OPTIONAL_TOOLS:
        print(f"tool      {tool}: {shutil.which(tool) or 'missing'}")
    return 0


def main() -> int:
    commands = {"init": init, "doctor": doctor}
    if len(sys.argv) != 2 or sys.argv[1] not in commands:
        print(__doc__.strip())
        return 2
    return commands[sys.argv[1]]()


if __name__ == "__main__":
    sys.exit(main())
