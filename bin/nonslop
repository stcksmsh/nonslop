#!/usr/bin/env python3
"""nonslop: a workflow for AI coding agents that does not ship slop.

  nonslop init            wire the current project (.nonslop.toml, .claude/settings.json, .gitignore)
  nonslop doctor          show what is wired and which tools are present
  nonslop check [args]    what an agent would be told now: static slop checks, then the project's gates
                          (args go to `slop check`: --all, --staged, --base <ref>, --fast, --json)
  nonslop rules           print the rules and project wiring agents receive
  nonslop slop <args>     run the vendored slopstop directly (selftest, doctor, check, ...)

Works from any shell. Inside Claude Code it is on PATH while the plugin is enabled.
"""

import json
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
TEMPLATES = PLUGIN_ROOT / "templates"
SLOP = PLUGIN_ROOT / "tools" / "slopstop" / "slop.py"
sys.path.insert(0, str(PLUGIN_ROOT / "scripts"))

from gates import run_gates  # noqa: E402
from nonslop_config import scratch_dir  # noqa: E402


def project_root() -> Path:
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        sys.exit("nonslop: not inside a git repository")
    return Path(result.stdout.strip())


def load_project(root: Path) -> dict:
    path = root / ".nonslop.toml"
    if not path.exists():
        sys.exit(f"nonslop: {path} missing (run `nonslop init`)")
    with path.open("rb") as handle:
        return tomllib.load(handle)


def merge_settings(target: Path) -> None:
    """Add nonslop's entries to a project's settings without removing anything already there."""
    template = json.loads((TEMPLATES / "settings.json").read_text(encoding="utf-8"))
    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(template, indent=2) + "\n", encoding="utf-8")
        print(f"  create  {target}")
        return
    try:
        settings = json.loads(target.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        sys.exit(f"nonslop: {target} is not valid JSON ({error}); fix it first")
    for key in ("env",):
        merged = settings.setdefault(key, {})
        for name, value in template[key].items():
            merged.setdefault(name, value)
    permissions = settings.setdefault("permissions", {})
    for kind in ("allow", "deny"):
        existing = permissions.setdefault(kind, [])
        existing.extend(rule for rule in template["permissions"][kind] if rule not in existing)
    target.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    print(f"  merge   {target}")


def ensure_ignored(root: Path, entry: str) -> None:
    gitignore = root / ".gitignore"
    lines = gitignore.read_text(encoding="utf-8").splitlines() if gitignore.exists() else []
    if entry in lines:
        return
    with gitignore.open("a", encoding="utf-8") as handle:
        handle.write(f"{entry}\n")
    print(f"  ignore  {entry}")


def cmd_init(_args: list[str]) -> int:
    root = project_root()
    config = root / ".nonslop.toml"
    if config.exists():
        print(f"  keep    {config} (already exists)")
    else:
        shutil.copyfile(TEMPLATES / "nonslop.toml", config)
        print(f"  create  {config}")
    merge_settings(root / ".claude" / "settings.json")
    ensure_ignored(root, ".claude/tmp/")
    print("\nNext: fill in [commands] in .nonslop.toml, review .claude/settings.json,")
    print("then commit both to the default branch so every worktree sees them.")
    return 0


def plugin_status() -> str:
    """Which nonslop Claude Code has installed, next to the version of this copy."""
    manifest = json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text(encoding="utf-8"))
    here = f"this copy {manifest['version']}"
    claude = shutil.which("claude")
    if claude is None:
        return f"unknown (claude CLI not on PATH); {here}"
    result = subprocess.run([claude, "plugin", "list", "--json"], capture_output=True, text=True, check=False)
    try:
        plugins = json.loads(result.stdout) if result.returncode == 0 else None
    except json.JSONDecodeError:
        plugins = None
    if plugins is None:
        return f"unknown (`claude plugin list --json` failed); {here}"
    for plugin in plugins:
        if plugin.get("id", "").startswith("nonslop@"):
            return (f"{plugin['id']} {plugin.get('version')} scope={plugin.get('scope')} "
                    f"enabled={plugin.get('enabled')}; {here}")
    return f"NOT installed (see README 'Install'); {here}"


def cmd_doctor(_args: list[str]) -> int:
    root = project_root()
    config = load_project(root)
    print(f"project   {root}")
    for name, command in config.get("commands", {}).items():
        print(f"command   {name}: {command or '(empty)'}")
    done = config.get("done", {})
    print(f"done      require={done.get('require', [])} run={done.get('run', [])} auto_clean={done.get('auto_clean', False)}")
    if state := config.get("state", {}).get("file"):
        print(f"state     {state} ({'present' if (root / state).exists() else 'missing'})")
    print(f"plugin    {plugin_status()}")
    # Flush first: slopstop writes straight to the terminal and would land above this heading.
    print("--- slopstop", flush=True)
    return subprocess.run([sys.executable, str(SLOP), "doctor"], cwd=root, check=False).returncode


def cmd_check(args: list[str]) -> int:
    root = project_root()
    config = load_project(root)
    slop_failed = subprocess.run([sys.executable, str(SLOP), "check", *args], cwd=root, check=False).returncode != 0
    failures = run_gates(config, root, scratch_dir(config, root))
    for failure in failures:
        print(f"nonslop: {failure}")
    if not failures and config.get("done", {}).get("run"):
        print("nonslop: gates passed")
    return 1 if slop_failed or failures else 0


def cmd_rules(_args: list[str]) -> int:
    script = PLUGIN_ROOT / "scripts" / "session_start.py"
    return subprocess.run([sys.executable, str(script), "--print"], check=False).returncode


def cmd_slop(args: list[str]) -> int:
    return subprocess.run([sys.executable, str(SLOP), *args], check=False).returncode


def main() -> int:
    commands = {"init": cmd_init, "doctor": cmd_doctor, "check": cmd_check, "rules": cmd_rules, "slop": cmd_slop}
    if len(sys.argv) < 2 or sys.argv[1] not in commands:
        print(__doc__.strip())
        return 2
    return commands[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
